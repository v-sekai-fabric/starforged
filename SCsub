#!/usr/bin/env python
# Build pipeline:
#   game.gd -> game.gen.elf -> game.gen.cpp -> linked into godot binary
#
# One binary ships. game.gd is embedded as bytes in a RISC-V ELF (via
# objcopy or llvm-objcopy), that ELF is embedded byte-for-byte into a
# generated C++ source, and the source compiles into the module. At
# runtime the sandbox module reads the array and hands it to libriscv.
# Model weights come from a CDN (huggingface) — not from disk.

Import("env")
Import("env_modules")

import shutil
import subprocess

env_game = env_modules.Clone()


def gd_to_gen_elf(target, source, env):
    """Wrap game.gd's bytes as a RISC-V ELF section.

    Tries llvm-objcopy (llvm toolchain, present on most dev machines)
    then GNU objcopy. --input-target binary reads the source as raw
    bytes; --output-target elf64-littleriscv writes a RISC-V ELF with
    the bytes exposed under symbols godot-sandbox can find.
    """
    src = str(source[0])
    dst = str(target[0])
    for tool in ("llvm-objcopy", "objcopy"):
        if shutil.which(tool) is None:
            continue
        subprocess.run(
            [tool,
             "--input-target=binary",
             "--output-target=elf64-littleriscv",
             "--binary-architecture=riscv",
             src, dst],
            check=True,
        )
        return None
    raise Exception(
        "modules/game: need llvm-objcopy or objcopy on PATH to build game.gen.elf "
        "(scoop install llvm on Windows, brew install llvm on macOS, "
        "apt install binutils on Linux)"
    )


def gen_elf_to_gen_cpp(target, source, env):
    """Embed the .gen.elf byte-for-byte as a C++ const array.

    Produces:
        extern "C" const size_t game_gen_elf_len = N;
        extern "C" const uint8_t game_gen_elf[] = { 0x7f, 0x45, ... };
    Godot's linker pulls both symbols into the binary; register_types.cpp
    references them at module init.
    """
    with open(str(source[0]), "rb") as f:
        data = f.read()
    lines = [
        "// Generated by modules/game/SCsub — do not edit; edit game.gd instead.",
        "#include <cstddef>",
        "#include <cstdint>",
        "",
        'extern "C" const size_t game_gen_elf_len = ' + str(len(data)) + ";",
        'extern "C" const uint8_t game_gen_elf[] = {',
    ]
    for i in range(0, len(data), 16):
        chunk = data[i:i + 16]
        lines.append("    " + ", ".join("0x%02x" % b for b in chunk) + ",")
    lines.append("};")
    with open(str(target[0]), "w") as f:
        f.write("\n".join(lines) + "\n")


env_game.Command("game.gen.elf", "game.gd", gd_to_gen_elf)
env_game.Command("game.gen.cpp", "game.gen.elf", gen_elf_to_gen_cpp)

env_game.add_source_files(env.modules_sources, [
    "register_types.cpp",
    "game.gen.cpp",
])
