#!/usr/bin/env python
# Build pipeline for the single-binary game:
#
#   game.gd  ──►  game.gen.elf  ──►  game.gen.cpp  ──►  linked into godot
#
# Step 1 wraps game.gd's bytes into a RISC-V ELF (llvm-objcopy /
# objcopy). Step 2 emits the ELF as an extern C byte array in
# game.gen.cpp. Step 3 lets env_modules pick up game.gen.cpp and
# link it into the godot binary. At runtime the sandbox module
# reads the array and hands it to libriscv, which interprets the
# ELF's RISC-V bytecode.
#
# One binary. No two-stage build, no stage-1 bootstrap, no godot-
# sandbox bintr / emit_binary_translation call. Interpretation-
# mode boot everywhere.
#
# Weights (motion-bricks, EditScore, Kimodo GGUFs) do NOT ship in
# the binary. They live in the release-side sqlar (uncompressed
# sqlar of zstd-compressed casync chunks) alongside the binary.

Import("env")
Import("env_modules")

import shutil
import subprocess


def gd_to_gen_elf(target, source, env):
    """game.gd -> game.gen.elf via objcopy (raw bytes into ELF section)."""
    src = str(source[0])
    dst = str(target[0])
    for tool in ("llvm-objcopy", "objcopy"):
        if shutil.which(tool) is None:
            continue
        subprocess.run(
            [tool,
             "--input-target=binary",
             "--output-target=elf64-littleriscv",
             "--binary-architecture=riscv",
             src, dst],
            check=True,
        )
        return None
    raise Exception(
        "modules/game: need llvm-objcopy or objcopy on PATH to build game.gen.elf "
        "(brew install llvm on macOS, apt install binutils on Linux, "
        "scoop install llvm on Windows)"
    )


def gen_elf_to_gen_cpp(target, source, env):
    """game.gen.elf -> game.gen.cpp as extern C byte array + length."""
    with open(str(source[0]), "rb") as f:
        data = f.read()
    lines = [
        "// Generated by modules/game/SCsub — do not edit; edit game.gd instead.",
        "#include <cstddef>",
        "#include <cstdint>",
        "",
        'extern "C" const size_t game_gen_elf_len = ' + str(len(data)) + ";",
        'extern "C" const uint8_t game_gen_elf[] = {',
    ]
    for i in range(0, len(data), 16):
        chunk = data[i:i + 16]
        lines.append("    " + ", ".join("0x%02x" % b for b in chunk) + ",")
    lines.append("};")
    with open(str(target[0]), "w") as f:
        f.write("\n".join(lines) + "\n")


env_game = env_modules.Clone()
env_game.Command("game.gen.elf", "game.gd", gd_to_gen_elf)
env_game.Command("game.gen.cpp", "game.gen.elf", gen_elf_to_gen_cpp)

env_game.add_source_files(env.modules_sources, [
    "register_types.cpp",
    "game.gen.cpp",
])
