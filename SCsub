#!/usr/bin/env python
# Build:
#
#   game.gd  ──►  game.gen.elf  ──►  $BUILD/sqlar-stage/game.gen.elf
#
# One godot binary. The ELF does NOT get bundled into gen.cpp at
# CI/CD time; it ships loose in the release-side sqlar alongside
# the binary. At runtime the sandbox module extracts the ELF from
# the sqlar and interprets it (fast start, cross-platform, no
# runtime codegen). For hot paths the sandbox module can call
# Sandbox::try_compile_binary_translation at first-run and cache
# the resulting .so under user:// so subsequent runs load the
# translated native path — that translation happens on the
# player's machine, not in CI/CD.
#
# Nothing links into the godot binary from this module.

Import("env")

import os
import shutil
import subprocess


STAGE_DIR = "#bin/sqlar-stage"


def gd_to_gen_elf(target, source, env):
    """game.gd -> game.gen.elf via llvm-objcopy / objcopy."""
    src = str(source[0])
    dst = str(target[0])
    for tool in ("llvm-objcopy", "objcopy"):
        if shutil.which(tool) is None:
            continue
        subprocess.run(
            [tool,
             "--input-target=binary",
             "--output-target=elf64-littleriscv",
             "--binary-architecture=riscv",
             src, dst],
            check=True,
        )
        return None
    raise Exception(
        "modules/game: need llvm-objcopy or objcopy on PATH to build game.gen.elf "
        "(brew install llvm on macOS, apt install binutils on Linux, "
        "scoop install llvm on Windows)"
    )


def stage_into_sqlar_drop(target, source, env):
    """Copy game.gen.elf into the sqlar-stage dir the release packager reads."""
    stage_dir = env.Dir(STAGE_DIR).abspath
    os.makedirs(stage_dir, exist_ok=True)
    shutil.copy(str(source[0]), os.path.join(stage_dir, "game.gen.elf"))


env_game = env.Clone()
env_game.Command("game.gen.elf", "game.gd", gd_to_gen_elf)
env_game.Command(env.File(STAGE_DIR + "/game.gen.elf"), "game.gen.elf", stage_into_sqlar_drop)

env_game.Alias("game_module_gen_elf", env.File(STAGE_DIR + "/game.gen.elf"))
env_game.Default(env_game.Alias("game_module_gen_elf"))
