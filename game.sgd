extends Node

# Root node for the Starforged decision-point VN (RFD 1175).
# class_name is blocked in .sgd — instances reach this script by
# resource path, not by a global class registry.
#
# File extension is .sgd — sandbox-godot-script. Every script in this
# project is a .sgd loaded via godot-sandbox; the engine ships with
# module_gdscript_enabled=no, so plain .gd is not parsed. godot-sandbox
# compiles .sgd sources to RISC-V ELFs (zig cc + libriscv) and runs
# them under libriscv (interpretation by default; opt-in bintr cached
# under user:// per player). Iterate at editor speed, keep the syntax
# GDScript-shaped for readability, ship as one binary + project (or
# .pck) alongside.

signal decision_point(legal_moves: Array)
signal move_outcome(outcome: StringName)


func _ready() -> void:
	pass


func _exit_tree() -> void:
	pass
